# --- LiveKit Cloud (project settings -> API keys) ---------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Model providers ---------------------------------------------------------
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Optional overrides
# LLM_MODEL=gpt-4.1-mini
# STT_MODEL=nova-3
# TTS_MODEL=sonic-3
# TTS_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
# ANALYSIS_MODEL=gpt-4.1
# MIN_ENDPOINTING_DELAY=0.7
# MAX_ENDPOINTING_DELAY=3.0

# --- Telephony (Twilio Elastic SIP trunk) -----------------------------------
# Only needed once, by scripts/setup_trunk.py
TWILIO_TERMINATION_URI=your-trunk.pstn.twilio.com
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
# The ONE number all test calls come from (E.164). Put this on the submission form.
CALLER_ID_NUMBER=+1XXXXXXXXXX

# Printed by scripts/setup_trunk.py
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx

# --- The test patient (match the account you created on the clinic's signup page) ---
PATIENT_FIRST_NAME=Alex
PATIENT_LAST_NAME=Rivera
# Written the way it should be spoken
PATIENT_DOB=March fourth, nineteen eighty-five
PATIENT_PHONE=five five five, two zero one, three four five six
