# voice-agent-qa configuration
# Copy to .env (never commit .env) and fill in. Values ending in xxxx or starting
# with "your-" are treated as NOT SET.
#
#   [console]  needed for local rehearsal:  python -m caller.agent console
#   [calls]    needed for real calls:       python scripts/run_calls.py ...
#   [optional] has a sensible default
#
# Check what's missing at any time:  python scripts/preflight.py --console   (or without --console)

# ---------------------------------------------------------------------------
# Speech + LLM providers                                          [console] [calls]
# ---------------------------------------------------------------------------
# Speech-to-text. https://console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=
# Patient LLM and the transcript analyzer. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Text-to-speech. https://play.cartesia.ai -> API Keys
CARTESIA_API_KEY=

# ---------------------------------------------------------------------------
# LiveKit Cloud (rooms, SIP dialing)                                        [calls]
# https://cloud.livekit.io -> your project -> Settings -> API keys
# Not needed for console. If set, console uses LiveKit's hosted turn detector;
# if not, it falls back to a local model automatically.
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Telephony: Twilio Elastic SIP trunk                                       [calls]
# ---------------------------------------------------------------------------
# Used once by scripts/setup_trunk.py to register the trunk with LiveKit.
TWILIO_TERMINATION_URI=your-trunk.pstn.twilio.com
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
# The ONE number all test calls come from, E.164 (e.g. +14155550100).
CALLER_ID_NUMBER=+1XXXXXXXXXX
# Printed by scripts/setup_trunk.py. Starts with ST_
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Target                                                                    [calls]
# ---------------------------------------------------------------------------
# The voice agent under test, E.164. The bot dials this number and refuses any
# other. Only test agents you own or have written permission to call.
TARGET_NUMBER=

# ---------------------------------------------------------------------------
# Test patient                                          [calls] required, [console] optional
# For real calls, use exactly the details of the test account you created on
# the system under test so the agent can find you. Use only fictional data.
# Console mode falls back to a fictional patient if these are empty:
#   Sarah Mitchell, March 15, 1992, +12125550147
# Some scenarios (e.g. new_patient_booking) use their own persona instead.
# ---------------------------------------------------------------------------
PATIENT_FIRST_NAME=
PATIENT_LAST_NAME=
# Written the way it should be spoken, e.g. March 15, 1992
PATIENT_DOB=
# E.164 or spoken form, e.g. +12125550147
PATIENT_PHONE=

# ---------------------------------------------------------------------------
# Tuning                                                               [optional]
# ---------------------------------------------------------------------------
# LLM_MODEL=gpt-4.1-mini
# STT_MODEL=nova-3
# TTS_MODEL=sonic-3
# Cartesia voice id (https://play.cartesia.ai/voices)
# TTS_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
# QA judge (scripts/analyze_calls.py): openai (default) or bedrock.
# ANALYSIS_PROVIDER=openai
# ANALYSIS_MODEL=gpt-4.1
# For Bedrock: pip install boto3, use a Bedrock model id or inference profile, and the
# usual AWS credential chain (env vars, ~/.aws or an IAM role).
# ANALYSIS_PROVIDER=bedrock
# ANALYSIS_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
# AWS_REGION=us-east-1
# Seconds of silence before the bot treats the clinic's turn as finished.
# Raise if the bot talks into pauses; lower if it feels slow.
# MIN_ENDPOINTING_DELAY=0.7
# MAX_ENDPOINTING_DELAY=3.0
